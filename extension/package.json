{
  "name": "macforms",
  "displayName": "WinForms Designer (cross-platform)",
  "description": "Visually design WinForms forms from Form.Designer.cs on macOS, Linux and Windows. Roslyn-accurate, surgical edits, no Wine.",
  "version": "0.1.0",
  "publisher": "macforms",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "winforms",
    "designer",
    "csharp",
    "forms"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onCustomEditor:macforms.formDesigner"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "macforms.formDesigner",
        "displayName": "WinForms Designer",
        "selector": [
          {
            "filenamePattern": "*.Designer.cs"
          }
        ],
        "priority": {
          "textEditor": "default",
          "diffEditor": "explicit"
        }
      }
    ],
    "commands": [
      {
        "command": "macforms.openInDesigner",
        "title": "WinForms: Open in Designer",
        "category": "WinForms"
      },
      {
        "command": "macforms.openInTextEditor",
        "title": "WinForms: Open as Text",
        "category": "WinForms"
      },
      {
        "command": "macforms.restartEngine",
        "title": "WinForms: Restart Design Engine",
        "category": "WinForms"
      },
      {
        "command": "macforms._testSeam",
        "title": "MacForms: (internal test seam)",
        "category": "WinForms"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "macforms.openInTextEditor",
          "when": "resourceExtname == .cs",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "macforms._testSeam",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "build:engine": "node ../scripts/publish-engine.js",
    "package:all": "node ../scripts/package-all.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}