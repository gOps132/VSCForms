{
  "name": "vscforms",
  "displayName": "VSCForms",
  "description": "Visually design WinForms forms from Form.Designer.cs on macOS, Linux and Windows. Roslyn-accurate, surgical edits, no Wine.",
  "version": "0.1.0",
  "publisher": "gOps132",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "winforms",
    "designer",
    "csharp",
    "forms"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onCustomEditor:vscforms.formDesigner",
    "onCommand:vscforms.newProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscforms.formDesigner",
        "displayName": "WinForms Designer",
        "selector": [
          {
            "filenamePattern": "*.Designer.cs"
          }
        ],
        "priority": {
          "textEditor": "default",
          "diffEditor": "explicit"
        }
      }
    ],
    "commands": [
      {
        "command": "vscforms.openInDesigner",
        "title": "Open in Designer",
        "category": "VSCForms"
      },
      {
        "command": "vscforms.openInTextEditor",
        "title": "Open as Text",
        "category": "VSCForms"
      },
      {
        "command": "vscforms.newProject",
        "title": "New Project…",
        "category": "VSCForms"
      },
      {
        "command": "vscforms.restartEngine",
        "title": "Restart Design Engine",
        "category": "VSCForms"
      },
      {
        "command": "vscforms._testSeam",
        "title": "(internal test seam)",
        "category": "VSCForms"
      }
    ],
    "configuration": {
      "title": "VSCForms",
      "properties": {
        "vscforms.enginePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the design engine binary. Leave empty to use the engine bundled with this extension. Only useful when developing the extension against an engine built by hand."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "vscforms.openInTextEditor",
          "when": "resourceExtname == .cs",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vscforms._testSeam",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "build:engine": "node ../scripts/publish-engine.js",
    "package:all": "node ../scripts/package-all.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}