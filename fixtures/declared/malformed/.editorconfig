root = true

[*.cs]
# Deliberately broken, and placed on the ONE key the engine actually reads, so the severity case
# is genuinely exercised rather than sitting harmlessly on a key nothing consumes.
dotnet_style_qualification_for_field = true:warning
# An empty value is a declaration with no answer.
dotnet_style_qualification_for_field =
# A line with no separator at all.
not a key value pair
# A leading '=' — the key is empty.
= true